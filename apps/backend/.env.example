# Copy to apps/backend/.env — loaded via config/load-env.ts (dotenv at backend root).

NODE_ENV=development
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mo_lk_assessment

# Required: value sent as x-api-key (global API guard)
X_API_KEY=

# Optional: comma-separated extra CORS origins (localhost dev origins are included by default)
# CORS_ORIGINS=https://your-app.example.com

SWAGGER_ENABLED=false
TYPEORM_LOGGING=false

# HttpOnly anonymous device cookies (GET /api/devices/session, order create, push-token)
# Max-Age in seconds (default ~400 days)
# DEVICE_COOKIE_MAX_AGE_SEC=34560000
# Force Secure flag on cookies (also auto-enabled when NODE_ENV=production or K_SERVICE is set)
# Cloud Run sets K_SERVICE — cookies use SameSite=None + Secure so credentialed cross-origin
# requests (Netlify SPA → Cloud Run API) store and send the device session cookie.
# DEVICE_COOKIE_SECURE=true
# Optional: e.g. .example.com when SPA and API share a parent domain
# DEVICE_COOKIE_DOMAIN=

# Firebase Admin — required to send FCM push notifications after order creation
# (JSON key from Firebase Console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM private key; use \n for newlines in a single-line env value
FIREBASE_PRIVATE_KEY=
