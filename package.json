  "scripts": {
    "migration:run": "cd apps/backend && npx typeorm-ts-node-commonjs -d ./src/config/database.config.ts migration:run",
    "migration:revert": "cd apps/backend && npx typeorm-ts-node-commonjs -d ./src/config/database.config.ts migration:revert",
    "migration:generate": "cd apps/backend && npx typeorm-ts-node-commonjs -d ./src/config/database.config.ts migration:generate ./src/migrations/MigrationName",
    "migration:create": "cd apps/backend && npx typeorm migration:create ./src/migrations/MigrationName",
    "seed:run": "cd apps/backend && npx ts-node --project tsconfig.app.json -r reflect-metadata ./src/seeds/run-seed.ts"
  },
  "private": true,
